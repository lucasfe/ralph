# Per-repo WhatsApp override (optional).
#
# By DEFAULT, Ralph reads WhatsApp notification credentials from your GLOBAL
# config at ~/.config/ralph/.env (honoring $XDG_CONFIG_HOME). Run `ralph init`
# in a terminal to set those up interactively — you normally do NOT need this
# file at all.
#
# Use `.env.local` ONLY when you want to OVERRIDE the global credentials for
# THIS repo (e.g. a different phone/key for one project). Values here take
# precedence over the global config. Copy this file to `.env.local` and fill in
# just the keys you want to override.
#
# Get your key by following:
#   https://www.callmebot.com/blog/free-api-whatsapp-messages/

CALLMEBOT_KEY=
WHATSAPP_PHONE=

# Optional: customize the WhatsApp message sent when Ralph starts.
# Defaults to "🟢 Ralph started and is active." when unset.
# RALPH_STARTUP_MESSAGE=
